{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "model_verdict", "scope_reviewed", "findings", "questions", "limitations"],
  "properties": {
    "summary": { "type": "string" },
    "model_verdict": { "type": "string", "enum": ["approve", "approve_with_comments", "request_changes"] },
    "scope_reviewed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line_start", "line_end"],
        "properties": { "file": { "type": "string" }, "line_start": { "type": "integer" }, "line_end": { "type": "integer" } }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "severity", "priority", "category", "confidence", "file", "line_start", "line_end", "evidence", "explanation", "fix", "cwe"],
        "properties": {
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "nit"] },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "category": { "type": "string", "enum": ["correctness", "security", "reliability", "error-handling", "concurrency", "performance", "resource-management", "data-integrity", "api-contract", "compatibility", "testing", "design", "maintainability", "readability", "documentation", "observability", "accessibility", "other"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "file": { "type": "string" },
          "line_start": { "type": "integer" },
          "line_end": { "type": "integer" },
          "evidence": { "type": "string" },
          "explanation": { "type": "string" },
          "fix": { "type": "string" },
          "cwe": { "type": "string" }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "file", "line"],
        "properties": { "question": { "type": "string" }, "file": { "type": "string" }, "line": { "type": "integer" } }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
